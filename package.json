{
    "name": "hackmd-sync",
    "version": "1.0.3",
    "description": "An interface to upload notes to HackMD from Obsidian",
    "main": "main.js",
    "type": "module",
    "scripts": {
        "dev": "tsc -noEmit -skipLibCheck --watch & node esbuild.config.mjs",
        "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
        "version": "node version-bump.mjs && git add manifest.json versions.json",
        "format": "prettier --write '{src,tests}/**/*.{ts,tsx}'",
        "format:check": "prettier --check '{src,tests}/**/*.{ts,tsx}'",
        "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts'",
        "lint:fix": "eslint --fix 'src/**/*.ts' 'tests/**/*.ts'",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "clean": "rm -rf node_modules package-lock.json main.js",
        "check": "npm run format:check && npm run lint && npm run test",
        "prepare": "npm run build",
        "preversion": "npm run check"
    },
    "keywords": [],
    "author": "Thor Kampefner",
    "license": "MIT",
    "devDependencies": {
        "@vitest/coverage-v8": "3.0.7",
        "builtin-modules": "5.0.0",
        "esbuild": "0.25.0",
        "eslint": "^9.21.0",
        "@hackmd/api": "^2.4.0",
        "obsidian": "latest",
        "prettier": "3.5.3",
        "tslib": "2.8.1",
        "typescript": "^5.7.3",
        "typescript-eslint": "8.25.0",
        "vitest": "3.0.7"
    },
    "dependencies": {}
}